{
  "id": "organelle",
  "name": "Organelle",
  "abbrev": "OR",
  "version": "0.0.1",
  "description": "Critter & Guitari Organelle Pure Data patch host (libpd)",
  "author": "charlesvestal",
  "license": "MIT",
  "ui_chain": "ui_chain.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": true,
    "midi_in": true,
    "midi_out": true,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Organelle",
          "params": [
            { "key": "patch_path",       "label": "Patch",         "type": "enum",  "options_param": "patch_list" },
            { "key": "octave_transpose", "label": "Octave",        "type": "int",   "min": -4, "max": 4, "default": 0 },
            { "key": "audio_in_enable",  "label": "Line In to Pd", "type": "enum",  "options": ["Off", "On"], "default": "On" },
            { "key": "gain",             "label": "Output Gain",   "type": "float", "min": 0, "max": 1.5, "step": 0.01, "default": 1.0 },
            { "key": "fs_source",        "label": "Foot Switch",   "type": "enum",  "options": ["Knob8 Touch", "Off"], "default": "Knob8 Touch" }
          ],
          "knobs": [
            "octave_transpose",
            "gain"
          ]
        }
      }
    }
  },
  "assets": {
    "path": "/data/UserData/schwung/organelle-patches",
    "label": "Patches",
    "description": "Drop Organelle patch folders here (each contains a main.pd).",
    "shared": true
  },
  "defaults": {
    "patch_path": "",
    "octave_transpose": 0,
    "audio_in_enable": "On",
    "gain": 1.0,
    "fs_source": "Knob8 Touch"
  }
}
